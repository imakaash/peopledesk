# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=sk-ant-...

# Signs login tokens (milestone 5). Must be random and at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Shared password for the demo users (alice, dave, bob, frank, carol). Defaults to nimbus123.
DEMO_PASSWORD=nimbus123
